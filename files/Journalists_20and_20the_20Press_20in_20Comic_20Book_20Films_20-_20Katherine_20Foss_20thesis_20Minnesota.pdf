    <!--BEGIN HEADLINE ENTRY BLOCK-->
             <h2>The Image of the Journalist in Silent Film
                 </h2>
                 <span class="text"><p><!--[if gte mso 9]><xml> <o:OfficeDocumentSettings> <o:RelyOnVML /> <o:AllowPNG /> </o:OfficeDocumentSettings> </xml><![endif]--></p>
