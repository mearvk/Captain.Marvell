        function adjustBannerPadding() {
            var navigationSection = $tudio('.evergreen-section.evergreen-section--navigation');
            var layoutHeader = $tudio('.evergreen-layout-header--small-banner');


            if (layoutHeader.length && navigationSection.length) {
                var navHeight = navigationSection.outerHeight(true);
                layoutHeader.css('--primaryNavigationModuleHeight', navHeight + 'px');
            }
        }

        $tudio(window).on("resize", function () {
            setTimeout(() => {
                adjustBannerPadding()
            }, "50");
        });

        $tudio(window).on('scrollend', function () {
            var navigationSection = $tudio('.evergreen-section.evergreen-section--navigation');
            if (!navigationSection.length) return;

            var lastHeight = -1;
            var maxAttempts = 30;

            function waitForStableHeight() {
                var currentHeight = navigationSection.outerHeight(true);
                if (currentHeight !== lastHeight && maxAttempts > 0) {
                    lastHeight = currentHeight;
                    maxAttempts--;
                    requestAnimationFrame(waitForStableHeight);
                } else {
                    adjustBannerPadding();
                }
            }

            requestAnimationFrame(waitForStableHeight);
        });

        function addFieldsetToSearch() {
            const searchDiv = document.querySelector('.evergreen-navigation-search');
            if (searchDiv) {
            const legend = document.createElement("legend");
            legend.textContent = "Search";
            legend.classList.add("sr-only");
            
            const fieldset = document.createElement("fieldset");
            while (searchDiv.firstChild) {
                fieldset.appendChild(searchDiv.firstChild);
            }
    
            fieldset.insertBefore(legend, fieldset.firstChild);
            searchDiv.appendChild(fieldset);
            }            
        }

