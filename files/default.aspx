  // Observe that links are added dynamically, so we need to use a mutation observer
  var observer = new MutationObserver(function(mutations) {
    mutations.forEach(function(mutation) {
      if (mutation.addedNodes.length) {
        var links = $('.evergreen-pane--sub-footer .evergreen-quick-link .evergreen-quick-link-layout--horizontal a');
        links.each(function() {
          var link = $(this);
          var classList = link.attr('class') ? link.attr('class').split(' ') : [];
          if (!classList.includes('evergreen-link')) {
            link.addClass('evergreen-link');
          }
        });
      }
    });
  });

  observer.observe(document.getElementById(quickLinksId), {
    childList: true,
    subtree: true
  });
    
