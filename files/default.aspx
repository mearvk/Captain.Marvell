<script>
    $tudio('#_ctrl0_ContentPane_overview_1_ctl04_divModuleContainer').q4Events({
        showFuture: true,
        showPast: true,
        limit: 4,
        fetchAllYears: true,
        useMoment: true,
        dateFormat: Object.assign({
            date: "MMMM D, YYYY",
            time: "h:mm A "
        } || {}, { "isoDate": "YYYY-MM-DD", "isoTime": "HH:mm:ssZ" }),
        tags: [""],
        showAllYears: true,
        sortAscending: false,
        yearContainer: '#_ctrl0_ContentPane_overview_1_ctl04_selectEvergreenEventYear',
        yearTemplate: '<option value="{{value}}">{{ year }}</option>',
        yearSelect: '#_ctrl0_ContentPane_overview_1_ctl04_selectEvergreenEventYear',
        itemNotFoundMessage: $tudio('#_ctrl0_ContentPane_overview_1_ctl04_divModuleContainertplEvergreenEventNoItems').html(),
        loadingMessage: $tudio("#_ctrl0_ContentPane_overview_1_ctl04_divModuleContainertplEvergreenEventLoading").html(),
        itemContainer: '#_ctrl0_ContentPane_overview_1_ctl04_divEventItemsContainer',
        itemTemplate: $tudio('#_ctrl0_ContentPane_overview_1_ctl04_divModuleContainertplEvergreenEvent').html(),
        itemsComplete: function (e) {
            q4EvergreenHelpers.addToCalendar($tudio(e.target).find('.evergreen-event-add-to-calendar'));
            if ($tudio(e.target).find('#_ctrl0_ContentPane_overview_1_ctl04_divModuleContainerdivEvergreenEventStatusAnnouncement').length) {
                announceSrOnlyEventCount(e);
            }
            if ($tudio(e.target).find('#_ctrl0_ContentPane_overview_1_ctl04_navEventPager').length) {
                $tudio(e.target).find('#_ctrl0_ContentPane_overview_1_ctl04_navEventPager').q4Pager({
                    content: $tudio(e.target).find('.evergreen-event-item'),
                    perPage: 0,
                    showPrevNext: true,
                    afterChange: function (e) {
                        announceSrOnlyEventCount(e);

                        var container = document.getElementById('_ctrl0_ContentPane_overview_1_ctl04_divEventItemsContainer');
                        if (container) {
                            var hiddenItems = document.querySelectorAll('.evergreen-event-item.js--hidden')
                            hiddenItems.forEach(hiddenItem => {
                                const parent = hiddenItem.closest('article');
                                if (parent) {
                                    parent.classList.add('js--hidden');
                                    parent.setAttribute('aria-hidden', 'true');
                                }
                            });

                            var visibleItems = document.querySelectorAll('.evergreen-event-item:not(.js--hidden)')
                            visibleItems.forEach(visibleItem => {
                                const parent = visibleItem.closest('article');
                                if (parent) {
                                    parent.classList.remove('js--hidden');
                                    parent.removeAttribute('aria-hidden');
                                }
                            });
                        }
                    }
                });
            }
        },
        complete: function (e) {
            if ($tudio('#_ctrl0_ContentPane_overview_1_ctl04_divEvergreenEventFilter').length) {
                $tudio(e.target).find('#_ctrl0_ContentPane_overview_1_ctl04_divModuleContainerdivEvergreenEventStatusAnnouncement').remove();
                announceSrOnlyEventCount(e);

                if ($tudio('#_ctrl0_ContentPane_overview_1_ctl04_divEvergreenEventYearTabContainer').length) {
                    function toggleTab(e, type) {
                        $tudio(e.target).closest('.evergreen-tabs').find('a').removeClass('evergreen--selected');
                        $tudio(e.target).addClass("evergreen--selected");
                        $tudio('#_ctrl0_ContentPane_overview_1_ctl04_divModuleContainer').q4Events(type);
                    }

                    $tudio('#_ctrl0_ContentPane_overview_1_ctl04_hrefEvergreenEventUpcomingTab').off().on('click', function (e) {
                        toggleTab(e, 'setShowFuture');
                    });
                    $tudio('#_ctrl0_ContentPane_overview_1_ctl04_hrefEvergreenEventPastTab').off().on('click', function (e) {
                        toggleTab(e, 'setShowPast');
                    })
                }
            }
        }
    });

    getSrOnlyEventCount = function () {
        var container = document.getElementById('_ctrl0_ContentPane_overview_1_ctl04_divEventItemsContainer');
        if (container) {
            var itemCount = container.querySelectorAll('.evergreen-event-item').length;
            var visibleItemCount = container.querySelectorAll('.evergreen-event-item:not(.js--hidden)').length;

            return visibleItemCount + ' (out of ' + itemCount + ')';
        }
        return "0";
    }

    announceSrOnlyEventCount = function (e) {
        var countText = getSrOnlyEventCount();
        q4EvergreenHelpers.a11yAnnouncement('polite', '_ctrl0_ContentPane_overview_1_ctl04_divModuleContainerdivEvergreenEventStatusAnnouncement', $tudio(e.target).find('#_ctrl0_ContentPane_overview_1_ctl04_divEvergreenEventFilter'), function (el) {
            var year = document.getElementById('_ctrl0_ContentPane_overview_1_ctl04_selectEvergreenEventYear');
            $tudio(el).text('Showing ' + countText + ' event(s) from year ' + ((year === null || year.value === '-1') ? 'All' : year.value));
        });
    }
</script>
