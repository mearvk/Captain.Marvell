# Captain Marvell Search Engine Configuration

# Search engines and their query URL templates
# {query} will be replaced with the search term

google=https://www.google.com/search?q={query}
bing=https://www.bing.com/search?q={query}
yahoo=https://search.yahoo.com/search?p={query}
duckduckgo=https://duckduckgo.com/?q={query}
baidu=https://www.baidu.com/s?wd={query}

# Crawler configuration
# Maximum number of redirects/link hops to follow per search result (up to 1000)
max.redirects=10
# Maximum crawl depth (how many pages deep to follow links from search results)
max.crawl.depth=10
# Connection timeout in seconds
connect.timeout=10
# Read timeout in seconds
read.timeout=15
# Maximum concurrent threads for parallel crawling
max.threads=20
# Delay between requests to same host (ms) to avoid rate limiting
crawl.delay.ms=100

# Search categories
categories=audio,images,files

# Search queries (comma-separated, all will be searched)
# Search queries (comma-separated, all will be searched)
queries=Captain Marvel, Captain Marvel USA Traditions, Captain Marvel History, Captain Marvel Description, Captain Marvel Powers, Captain Marvel Origin Stories

# Search importance (0-9000). Determines which parsing strategy is used.
# 0-1800: fibonacci (basic), 1801-3600: galileo (observational),
# 3601-5400: davinci (multi-faceted), 5401-7200: marconi (signal-tracing),
# 7201-9000: fermi (exhaustive)
search.importance=7200

# When true, download all recognized file types found on a page even if
# the current search category is narrower (e.g. searching "audio" but page also has images)
download.all.found.on.page=true

# Debug mode: when enabled, halts the program when downloadable files are detected
# on a page but none are actually downloaded. Useful for diagnosing extraction issues.
debug.halt.on.missed.downloads=true